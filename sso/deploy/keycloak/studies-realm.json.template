{
  "realm": "studies",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "roles": {
    "realm": [
      { "name": "user", "description": "Regular application user (TodoForSso)" },
      { "name": "customer", "description": "Regular shop customer (KShop)" },
      { "name": "admin", "description": "Application administrator" },
      {
        "name": "default-roles-studies",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": ["offline_access", "uma_authorization", "user", "customer"],
          "client": { "account": ["manage-account", "view-profile"] }
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-studies",
    "description": "${role_default-roles}",
    "composite": true,
    "clientRole": false
  },
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "hideOnLogin": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "updateProfileFirstLoginMode": "on",
      "config": {
        "clientId": "__GOOGLE_CLIENT_ID__",
        "clientSecret": "__GOOGLE_CLIENT_SECRET__",
        "syncMode": "IMPORT",
        "defaultScope": "openid profile email"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "Email",
      "identityProviderAlias": "google",
      "identityProviderMapper": "google-user-attribute-mapper",
      "config": { "syncMode": "INHERIT", "userAttribute": "email" }
    },
    {
      "name": "FirstName",
      "identityProviderAlias": "google",
      "identityProviderMapper": "google-user-attribute-mapper",
      "config": { "syncMode": "INHERIT", "userAttribute": "firstName" }
    },
    {
      "name": "LastName",
      "identityProviderAlias": "google",
      "identityProviderMapper": "google-user-attribute-mapper",
      "config": { "syncMode": "INHERIT", "userAttribute": "lastName" }
    },
    {
      "name": "GrantUserRole",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-hardcoded-role-idp-mapper",
      "config": { "syncMode": "FORCE", "role": "user" }
    },
    {
      "name": "GrantCustomerRole",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-hardcoded-role-idp-mapper",
      "config": { "syncMode": "FORCE", "role": "customer" }
    }
  ],
  "clients": [
    {
      "clientId": "todoforsso-frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["+"],
      "attributes": {
        "post.logout.redirect.uris": "+",
        "login_theme": "todoforsso"
      },
      "protocolMappers": [
        {
          "name": "todoforsso-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "todoforsso-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "kshop-frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:5174/*"],
      "webOrigins": ["+"],
      "attributes": {
        "post.logout.redirect.uris": "+",
        "login_theme": "kshop"
      },
      "protocolMappers": [
        {
          "name": "kshop-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "kshop-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "testuser",
      "enabled": true,
      "emailVerified": true,
      "email": "testuser@studies.local",
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        { "type": "password", "value": "testuser123", "temporary": false }
      ],
      "realmRoles": ["user", "customer"]
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@studies.local",
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        { "type": "password", "value": "admin123", "temporary": false }
      ],
      "realmRoles": ["admin", "user", "customer"]
    }
  ]
}
